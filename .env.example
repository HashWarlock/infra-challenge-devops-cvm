# Container Configuration
CONTAINER_NAME=go-application
UBUNTU_VERSION=22.04

# Go Configuration
GO_VERSION=1.21.5

# Repository Configuration
GITHUB_REPO=https://github.com/HashWarlock/infra-challenge-devops-cvm.git
REPO_BRANCH=main
COMMIT_HASH=

# Port Configuration
APP_PORT=8080
HOST_PORT=8080

# Restart Policy (no, always, on-failure, unless-stopped)
RESTART_POLICY=unless-stopped

# Example configurations for different scenarios:

# --- Development (latest from main) ---
# REPO_BRANCH=main
# COMMIT_HASH=

# --- Staging (specific commit for testing) ---
# REPO_BRANCH=main
# COMMIT_HASH=abc123def456

# --- Production (pinned to verified commit) ---
# REPO_BRANCH=main
# COMMIT_HASH=xyz789abc123

# --- Use different Go version ---
# GO_VERSION=1.22.0

# --- Use different Ubuntu version ---
# UBUNTU_VERSION=24.04